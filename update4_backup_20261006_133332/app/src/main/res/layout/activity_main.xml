<?xml version="1.0" encoding="utf-8"?>
<!-- Scrolls only when the list of opponents (including your saved agents) is taller than the screen. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/textview_first"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WELCOME TO FISHSTOCK"
        android:textSize="30sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="0dp" />

    <TextView
        android:id="@+id/hard_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hard Mode:"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@+id/textview_first"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Switch
        android:id="@+id/hardModeSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="false"
        android:text=""
        app:layout_constraintTop_toBottomOf="@+id/hard_mode"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Play as:"
        android:textSize="25sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textview_first" />

    <Button
        android:id="@+id/WHITE"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WHITE"
        app:layout_constraintEnd_toStartOf="@+id/BLACK"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2"
        android:layout_marginTop="8dp"
        app:layout_constraintHorizontal_chainStyle="packed" />

    <Button
        android:id="@+id/BLACK"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BLACK"
        android:textColor="#000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/WHITE"
        app:layout_constraintTop_toBottomOf="@+id/textView2"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        app:strokeColor="#1B1111" />

    <!-- LinearLayout for Level/Opponent alignment -->
    <TextView
        android:id="@+id/textview_second"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Please Select Your Opponent"
        android:textSize="25sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/WHITE" />

    <!-- Opponent picker: built-in agents weakest first, then your saved agents.
         Ones you have beaten are green, one that beat you last time is red. -->
    <LinearLayout
        android:id="@+id/opponentLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textview_second"
        android:layout_marginTop="16dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp">

        <Spinner
            android:id="@+id/opponentSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:spinnerMode="dropdown" />

        <!-- One line about how the selected opponent plays -->
        <TextView
            android:id="@+id/opponentDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:minLines="2"
            android:text=""
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/playOpponent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:minHeight="56dp"
                android:text="PLAY"
                android:textSize="18sp" />

            <!-- Only for your own agents -->
            <Button
                android:id="@+id/editAgent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minHeight="56dp"
                android:text="EDIT"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Human Player Section -->
    <LinearLayout
        android:id="@+id/humanLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/opponentLayout"
        android:layout_marginTop="16dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Or Play Against a Human:"
            android:textSize="18sp"
            android:gravity="center" />

        <Button
            android:id="@+id/playHuman"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HUMAN" />
    </LinearLayout>

    <!-- Two-player option: turn the board to face whoever is to move, or leave it -->
    <LinearLayout
        android:id="@+id/twoPlayerOptions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/humanLayout"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Turn board after each move:"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/autoFlipSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:minHeight="48dp"
            android:text="" />
    </LinearLayout>

    <!-- Puzzles -->
    <Button
        android:id="@+id/puzzlesButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Puzzles"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/twoPlayerOptions" />

    <!-- Make Your Own Agent -->
    <Button
        android:id="@+id/makeAgentButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Make Your Own Agent"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/puzzlesButton" />

    <!-- Tournament Button -->
    <Button
        android:id="@+id/tournamentButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Agent Tournament"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@+id/makeAgentButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="1.0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="0dp" />


</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
