    <!-- What the phone heard last, and whether it was a move -->
    <TextView
        android:id="@+id/recordHeard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minLines="2"
        android:text=""
        android:textSize="16sp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/gridlayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/recordButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/recordHeard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <Button
            android:id="@+id/recordListen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:text="Listen" />
        <Button
            android:id="@+id/recordUndo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Undo" />
        <Button
            android:id="@+id/recordFlip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Flip" />
    </LinearLayout>

    <!-- Read each move back after it is recorded, so you know it was heard right without looking -->
    <Switch
        android:id="@+id/recordSpeakBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:minHeight="48dp"
        android:text="Say each move back  "
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@+id/recordButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 1. e4 e5 2. Nf3 Nc6 ... -->
    <TextView
        android:id="@+id/recordMoves"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minLines="3"
        android:text=""
        android:textIsSelectable="true"
        android:textSize="18sp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/recordSpeakBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/recordFinishRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@+id/recordMoves"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <Button
            android:id="@+id/recordNewGame"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="New Game" />
        <Button
            android:id="@+id/recordAnalyze"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Analyze" />
    </LinearLayout>

    <!-- How to say moves -->
    <TextView
        android:id="@+id/recordHelp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="Say moves as you would write them: &quot;e4&quot;, &quot;knight f3&quot;, &quot;e takes d5&quot;, &quot;bishop takes knight&quot;, &quot;castles kingside&quot;, &quot;e8 queen&quot;. If two pieces can go to the same square, add the file or rank: &quot;knight b d2&quot;. Say &quot;undo&quot; to take the last move back. You can also tap the moves in on the board."
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@+id/recordFinishRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
