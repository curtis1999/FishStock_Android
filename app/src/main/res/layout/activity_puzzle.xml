            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:adjustViewBounds="true"
            android:background="#FF000000"
            android:scaleType="fitXY"
            android:tag="7,0"
            tools:src="@drawable/empty_dark" />

        <ImageButton
            android:id="@+id/button71"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:adjustViewBounds="true"
            android:background="#00000000"
            android:scaleType="fitXY"
            android:tag="7,1"
            tools:src="@drawable/empty_light" />

        <ImageButton
            android:id="@+id/button72"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:adjustViewBounds="true"
            android:background="#FF000000"
            android:scaleType="fitXY"
            android:tag="7,2"
            tools:src="@drawable/empty_dark" />

        <ImageButton
            android:id="@+id/button73"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:adjustViewBounds="true"
            android:background="#00000000"
            android:scaleType="fitXY"
            android:tag="7,3"
            tools:src="@drawable/empty_light" />

        <ImageButton
            android:id="@+id/button74"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:adjustViewBounds="true"
            android:background="#FF000000"
            android:scaleType="fitXY"
            android:tag="7,4"
            tools:src="@drawable/empty_dark" />

        <ImageButton
            android:id="@+id/button75"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:adjustViewBounds="true"
            android:background="#00000000"
            android:scaleType="fitXY"
            android:tag="7,5"
            tools:src="@drawable/empty_light" />

        <ImageButton
            android:id="@+id/button76"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:adjustViewBounds="true"
            android:background="#FF000000"
            android:scaleType="fitXY"
            android:tag="7,6"
            tools:src="@drawable/empty_dark" />

        <ImageButton
            android:id="@+id/button77"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:adjustViewBounds="true"
            android:background="#00000000"
            android:scaleType="fitXY"
            android:tag="7,7"
            tools:src="@drawable/empty_light" />
        />
    </GridLayout>

    <!-- Step back and forward through the moves once the puzzle is over -->
    <LinearLayout
        android:id="@+id/puzzleNav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/gridlayout"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="8dp">

        <Button
            android:id="@+id/puzzleBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:text="◀"
            android:textSize="16sp" />

        <Button
            android:id="@+id/puzzleForward"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="▶"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Feedback: correct / try again / the solution line -->
    <TextView
        android:id="@+id/puzzleFeedback"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minLines="2"
        android:text=""
        android:textSize="18sp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/puzzleNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/puzzleButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@+id/puzzleFeedback"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/puzzleHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hint" />

        <Button
            android:id="@+id/puzzleSolution"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Solution" />
    </LinearLayout>

    <Button
        android:id="@+id/generatePuzzle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Generate Puzzle"
        android:textSize="18sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/puzzleButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Select theme: a new puzzle (any / endgame), or one from the collection grouped by theme -->
    <LinearLayout
        android:id="@+id/puzzleModeRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/generatePuzzle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select theme:"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/themeSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:spinnerMode="dropdown" />
    </LinearLayout>

    <!-- "Searching... 120 positions checked" -->
    <TextView
        android:id="@+id/puzzleProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@+id/puzzleModeRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
