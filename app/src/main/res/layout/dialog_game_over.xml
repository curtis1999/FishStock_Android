<?xml version="1.0" encoding="utf-8"?>
<!-- GAME OVER box. Same words and colours as before; the window is sized to ~90% of the screen
     width in GameOverDialog, and PLAY AGAIN gets its own row so no button text is squeezed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="GAME OVER"
        android:textColor="#000000"
        android:textSize="46sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/winnerMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Good Game!"
        android:textColor="#000000"
        android:textSize="30sp" />

    <!-- How it ended: "by checkmate", "by threefold repetition", ... -->
    <TextView
        android:id="@+id/gameOverReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text=""
        android:textColor="#555555"
        android:textSize="16sp" />

    <Button
        android:id="@+id/playAgain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:minHeight="56dp"
        android:text="PLAY AGAIN"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/buttonsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/analyze"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:minHeight="56dp"
            android:text="ANALYZE"
            android:textSize="15sp" />

        <Button
            android:id="@+id/exit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:minHeight="56dp"
            android:text="EXIT"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>
