<?xml version="1.0" encoding="utf-8"?>
<!-- VIEW LINES: every legal move's evaluation as a bar chart, plus what the spread says about
     the position. Filled in by GameAnalysis as the scores arrive. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="LINES"
            android:textColor="#000000"
            android:textSize="30sp" />

        <!-- "White to move - 32 legal moves - depth 3" -->
        <TextView
            android:id="@+id/linesSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Scoring every move..."
            android:textColor="#555555"
            android:textSize="14sp" />

        <com.example.fishstock.ui.MoveSpectrumView
            android:id="@+id/moveSpectrum"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginTop="12dp" />

        <!-- The tapped move: "Nf3  +0.42  (best)" -->
        <TextView
            android:id="@+id/spectrumCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Tap a bar to see the move"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- "11 moves keep White better, 9 are about level, 12 leave White worse" -->
        <TextView
            android:id="@+id/linesCounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text=""
            android:textColor="#000000"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/positionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text=""
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/positionLabelDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#000000"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/linesStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#555555"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/linesSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#555555"
            android:textSize="14sp" />

        <Button
            android:id="@+id/closeLines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="52dp"
            android:text="CLOSE" />
    </LinearLayout>
</ScrollView>
