<?xml version="1.0" encoding="utf-8"?>
<!-- VIEW RESULTS: one row per game (who had White, the result, how it ended) with VIEW GAME,
     which opens the game on the analysis screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dialog_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="RESULTS"
        android:textColor="#000000"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/matchSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text=""
        android:textColor="#555555"
        android:textSize="15sp" />

    <ScrollView
        android:id="@+id/matchGamesScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/matchGames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <!-- Sends the summary and the full CSV history to another app (email, notes...) -->
        <Button
            android:id="@+id/shareResults"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="SHARE AS TEXT"
            android:textSize="14sp" />

        <Button
            android:id="@+id/closeResults"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="CLOSE"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
