<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen: choose Agent or Human, then (for an agent) your colour and the opponent, then PLAY.
     Scrolls only when it doesn't fit. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/textview_first"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WELCOME TO FISHSTOCK"
            android:textSize="30sp" />

        <!-- Hard mode: no take-backs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hard_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hard Mode:"
                android:textSize="20sp" />

            <Switch
                android:id="@+id/hardModeSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:minHeight="48dp"
                android:text="" />
        </LinearLayout>

        <!-- Agent or human first -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Play against:"
            android:textSize="25sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/vsAgent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AGENT" />

            <Button
                android:id="@+id/vsHuman"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="HUMAN"
                android:textColor="#000000" />
        </LinearLayout>

        <!-- Only when playing an agent: your colour and which agent -->
        <LinearLayout
            android:id="@+id/agentOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Play as:"
                android:textSize="25sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/WHITE"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WHITE" />

                <Button
                    android:id="@+id/BLACK"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="BLACK"
                    android:textColor="#000000" />
            </LinearLayout>

            <TextView
                android:id="@+id/textview_second"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Please Select Your Opponent"
                android:textSize="25sp" />

            <!-- Built-in agents weakest first, then your saved agents. Beaten = green, lost to last time = red. -->
            <Spinner
                android:id="@+id/opponentSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="32dp"
                android:minHeight="56dp"
                android:spinnerMode="dropdown" />

            <!-- One line about how the selected opponent plays -->
            <TextView
                android:id="@+id/opponentDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="32dp"
                android:gravity="center"
                android:minLines="2"
                android:text=""
                android:textSize="15sp" />

            <!-- Only for your own agents -->
            <Button
                android:id="@+id/editAgent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EDIT AGENT"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Two players sharing the phone: White at the bottom, the board doesn't turn -->
        <TextView
            android:id="@+id/humanDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="32dp"
            android:gravity="center"
            android:text="Two players on one phone. White plays from the bottom of the board."
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/playButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="32dp"
            android:minHeight="56dp"
            android:text="PLAY"
            android:textSize="20sp" />

        <Button
            android:id="@+id/puzzlesButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Puzzles"
            android:textSize="18sp" />

        <Button
            android:id="@+id/makeAgentButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Make Your Own Agent"
            android:textSize="18sp" />

        <Button
            android:id="@+id/tournamentButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Agent Tournament"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
