<?xml version="1.0" encoding="utf-8"?>
<!-- IMPORT GAME box on the analysis screen: paste a PGN (or just the moves), pick whose side to
     review the game from, ANALYZE. Same card and button style as the Game Over box. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dialog_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="IMPORT GAME"
            android:textColor="#000000"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Paste a PGN, or just the moves in order"
            android:textColor="#555555"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/importText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="top|start"
            android:hint="1. e4 e5 2. Nf3 Nc6 3. Bb5 a6 ..."
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:maxLines="8"
            android:minLines="5"
            android:scrollbars="vertical"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:textSize="14sp" />

        <Button
            android:id="@+id/importPaste"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PASTE"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Review the game as:"
            android:textColor="#000000"
            android:textSize="20sp" />

        <!-- Same toggle as "Play as" on the home screen: the chosen side has white text -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/importWhite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WHITE" />

            <Button
                android:id="@+id/importBlack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="BLACK"
                android:textColor="#000000" />
        </LinearLayout>

        <!-- What couldn't be read, e.g. "Couldn't play "Nxe9" at move 14 (White)" -->
        <TextView
            android:id="@+id/importError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text=""
            android:textColor="#E40D0D"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/importAnalyze"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:minHeight="56dp"
                android:text="ANALYZE"
                android:textSize="15sp" />

            <Button
                android:id="@+id/importCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:minHeight="56dp"
                android:text="CANCEL"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
